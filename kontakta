<!doctype html>
<html class="page" lang="sv">
  <head>
    <title>Pannkakor</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="images/logo_white.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="styles/style.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="page__body">
    <header class="page__header">
      <nav class="navbar" role="navigation" aria-label="Main Navigation">
        <ul class="navbar__list">
          <li class="navbar__item navbar__logo" aria-current="page">
            <a
              class="navbar__link navbar__logo__link navbar__link--active"
              href="index.html"
            >
              <img
                src="images/logo_color.svg"
                class="navbar__item__logo"
                alt="Superchef Home"
              />
            </a>
          </li>
          <li class="navbar__item">
            <a class="navbar__link" href="gallery.html">Recept</a>
          </li>
          <li class="navbar__item">
            <a class="navbar__link" href="#">Om oss</a>
          </li>
          <li class="navbar__item">
            <a class="navbar__link" href="#">Kontakt</a>
          </li>
          <li class="navbar__item">
            <button class="navbar__button">Logga in</button>
          </li>
        </ul>
      </nav>
      <section class="contact-form">
        <h1 class="contact-form__heading">Kontakta oss</h1>
        <form class="contact-form__form" action="#" method="post">
          <label for="name" class="contact-form__label">Namn:</label>
          <input
            type="text"
            id="name"
            name="name"
            class="contact-form__input"
            required
          />

          <label for="email" class="contact-form__label">E-post:</label>
          <input
            type="email"
            id="email"
            name="email"
            class="contact-form__input"
            required
          />

          <label for="message" class="contact-form__label">Meddelande:</label>
          <textarea
            id="message"
            name="message"
            class="contact-form__textarea"
            rows="5"
            required
          ></textarea>

          <button type="submit" class="contact-form__button">
            Skicka meddelande
          </button>
        </form>
      </section>
    </div>
  </body>
</html>
